# ==========================================
# PREP VR - Centralized Placement Backend
# Environment Configuration
# ==========================================

PORT=5000
NODE_ENV=development

# PostgreSQL Connection String
# For local Docker: postgresql://prepvr:prepvr_password@localhost:5432/prepvr_placement?schema=public
# For embedded/local db runner: postgresql://prepvr:prepvr_password@localhost:5432/prepvr_placement?schema=public
DATABASE_URL="postgresql://prepvr:prepvr_password@localhost:5432/prepvr_placement?schema=public"

# JWT Secret for Placement Staff Authentication
JWT_SECRET="prepvr_super_secret_jwt_key_placement_2026"
JWT_EXPIRES_IN="7d"

# Allowed CORS Origins (comma separated)
CORS_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# Initial Placement Admin Credentials (for seed/login)
PLACEMENT_ADMIN_EMAIL="admin@prepvr.edu"
PLACEMENT_ADMIN_PASSWORD="Placement@2026"

# Reports Storage Path
REPORTS_STORAGE_PATH="./reports"
