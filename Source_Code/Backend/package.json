{
  "name": "prepvr-backend",
  "version": "1.0.0",
  "description": "Centralized Student Placement Data System Backend API for PREP VR",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "ts-node src/index.ts",
    "db:start": "node scripts/start-db.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "ts-node prisma/seed.ts",
    "test:api": "ts-node scripts/test-api.ts"
  },
  "keywords": [
    "prepvr",
    "placement",
    "api",
    "prisma",
    "postgresql",
    "express"
  ],
  "author": "PREP VR Engineering",
  "license": "ISC",
  "dependencies": {
    "@electric-sql/pglite": "^0.2.14",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pg-gateway": "^0.3.0-beta.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
